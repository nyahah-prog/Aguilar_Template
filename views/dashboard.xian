<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body class="bg-[#0b0c10] text-slate-200 flex min-h-screen font-sans">

  {{> sidebar}}

  <div class="flex-1 flex flex-col min-w-0">
    {{> header}}

    <main class="p-6 flex-1 space-y-6 overflow-y-auto">
      
      {{> breadcrumbs}}

      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 lg:col-span-7 space-y-6">
          {{> metrics}}
          {{> table}}
        </div>

        <div class="col-span-12 lg:col-span-5 space-y-6">
          <div class="bg-[#171a29] border border-slate-800/80 rounded-xl p-4">
            <h4 class="text-xs font-medium text-slate-400">Sales this months</h4>
            <div class="mt-3 flex items-center space-x-2">
              <span class="text-xl font-bold text-white">$14,094</span>
              <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded">↑ 4.2%</span>
            </div>
            <div class="h-32 mt-4">
              <svg class="w-full h-full" viewBox="0 0 300 100" preserveAspectRatio="none">
                <path d="M0,80 Q50,40 100,60 T200,30 T300,50 L300,100 L0,100 Z" fill="rgba(6, 182, 212, 0.15)" />
                <path d="M0,80 Q50,40 100,60 T200,30 T300,50" fill="none" stroke="#06b6d4" stroke-width="2" />
              </svg>
            </div>
          </div>

          <div class="bg-[#171a29] border border-slate-800/80 rounded-xl p-4">
            <h4 class="text-xs font-medium text-slate-400">Discounted Product Sales</h4>
            <div class="mt-3 flex items-center space-x-2">
              <span class="text-xl font-bold text-white">$3,706</span>
              <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded">↑ 3.8%</span>
            </div>
            <div class="h-32 mt-4">
              <svg class="w-full h-full" viewBox="0 0 300 100" preserveAspectRatio="none">
                <path d="M0,50 Q40,80 80,40 T160,50 T240,20 T300,40 L300,100 L0,100 Z" fill="rgba(14, 165, 233, 0.15)" />
                <path d="M0,50 Q40,80 80,40 T160,50 T240,20 T300,40" fill="none" stroke="#0ea5e9" stroke-width="2" />
              </svg>
            </div>
          </div>
        </div>
      </div>
    </main>

    {{> footer}}
  </div>

</body>
</html>