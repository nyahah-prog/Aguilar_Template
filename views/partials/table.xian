<div class="bg-[#171a29] border border-slate-800/80 rounded-xl p-4">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-sm font-bold text-white">Recent Orders</h3>
  </div>

  <div class="flex space-x-2 mb-4">
    <button class="px-3 py-1.5 bg-blue-600/30 border border-blue-500/40 text-blue-400 rounded-lg text-xs font-medium">Headphones</button>
    <button class="px-3 py-1.5 bg-[#121420] text-slate-400 rounded-lg text-xs">Drives</button>
    <button class="px-3 py-1.5 bg-[#121420] text-slate-400 rounded-lg text-xs">T-shirt</button>
    <button class="px-3 py-1.5 bg-[#121420] text-slate-400 rounded-lg text-xs">Watch</button>
  </div>

  <div class="overflow-x-auto text-xs">
    <table class="w-full text-left">
      <thead>
        <tr class="text-slate-500 border-b border-slate-800">
          <th class="pb-2 font-medium">Item</th>
          <th class="pb-2 font-medium">Quantity</th>
          <th class="pb-2 font-medium">Price</th>
          <th class="pb-2 font-medium">Total</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-slate-300">
        <tr>
          <td class="py-2.5 flex items-center space-x-2">
            <div class="w-6 h-6 bg-slate-800 rounded flex items-center justify-center">🎧</div>
            <div><p class="text-white font-medium">Apple AirPods Max</p><p class="text-[10px] text-slate-500">Item: MQD83</p></div>
          </td>
          <td>×1</td>
          <td>$615.00</td>
          <td class="text-white font-medium">$615.00</td>
        </tr>
        <tr>
          <td class="py-2.5 flex items-center space-x-2">
            <div class="w-6 h-6 bg-slate-800 rounded flex items-center justify-center">🎧</div>
            <div><p class="text-white font-medium">Bang & Olufsen</p><p class="text-[10px] text-slate-500">Item: HK-164er</p></div>
          </td>
          <td>×2</td>
          <td>$681.00</td>
          <td class="text-white font-medium">$1362.00</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>