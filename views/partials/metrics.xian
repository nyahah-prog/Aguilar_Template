<div class="grid grid-cols-2 gap-4">
  <div class="bg-[#171a29] border border-slate-800/80 rounded-xl p-4">
    <div class="flex items-center space-x-2">
      <span class="text-xl font-bold text-white">$69,700</span>
      <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded">↑ 2.2%</span>
    </div>
    <p class="text-[10px] text-slate-500 mt-0.5 mb-3">Expected Earnings</p>
    
    <div class="flex items-center space-x-4">
      <div class="w-12 h-12 rounded-full border-4 border-cyan-400 border-t-purple-500 border-r-pink-500"></div>
      <div class="text-[10px] space-y-1">
        <div class="flex items-center space-x-1.5"><span class="w-2 h-2 rounded-full bg-cyan-400"></span><span class="text-slate-400">Shoes</span> <span class="text-white font-medium">$7,660</span></div>
        <div class="flex items-center space-x-1.5"><span class="w-2 h-2 rounded-full bg-purple-500"></span><span class="text-slate-400">Gaming</span> <span class="text-white font-medium">$2,820</span></div>
        <div class="flex items-center space-x-1.5"><span class="w-2 h-2 rounded-full bg-pink-500"></span><span class="text-slate-400">Others</span> <span class="text-white font-medium">$25,257</span></div>
      </div>
    </div>
  </div>

  <div class="bg-[#171a29] border border-slate-800/80 rounded-xl p-4 flex flex-col justify-between">
    <div>
      <div class="flex items-center space-x-2">
        <span class="text-xl font-bold text-white">$2,420</span>
        <span class="text-[10px] font-bold text-emerald-400 bg-emerald-500/10 px-1.5 py-0.5 rounded">↑ 2.6%</span>
      </div>
      <p class="text-[10px] text-slate-500 mt-0.5">Average Daily Sales</p>
    </div>
    
    <div class="flex items-end justify-between h-10 gap-1 pt-2">
      <div class="w-2 bg-cyan-400 h-1/2 rounded-t-sm"></div>
      <div class="w-2 bg-cyan-400 h-3/4 rounded-t-sm"></div>
      <div class="w-2 bg-cyan-400 h-full rounded-t-sm"></div>
      <div class="w-2 bg-cyan-400 h-2/3 rounded-t-sm"></div>
      <div class="w-2 bg-cyan-400 h-4/5 rounded-t-sm"></div>
      <div class="w-2 bg-cyan-400 h-full rounded-t-sm"></div>
    </div>
  </div>

  <div class="bg-[#171a29] border border-slate-800/80 rounded-xl p-4">
    <div class="flex items-center space-x-2">
      <span class="text-xl font-bold text-white">1,836</span>
      <span class="text-[10px] font-bold text-rose-400 bg-rose-500/10 px-1.5 py-0.5 rounded">↓ 1.0%</span>
    </div>
    <p class="text-[10px] text-slate-500 mt-0.5 mb-4">Orders this Month</p>
    <div class="space-y-1">
      <div class="flex justify-between text-[10px]"><span class="text-slate-400">1,048 to Goal</span><span class="text-slate-300 font-medium">62%</span></div>
      <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden"><div class="bg-cyan-400 h-full w-[62%]"></div></div>
    </div>
  </div>

  <div class="bg-[#171a29] border border-slate-800/80 rounded-xl p-4">
    <span class="text-xl font-bold text-white">6.3k</span>
    <p class="text-[10px] text-slate-500 mt-0.5 mb-3">New Customers This Month</p>
    <div class="flex -space-x-1.5">
      <img src="https://i.pravatar.cc/100?img=12" class="w-6 h-6 rounded-full border border-[#171a29]" />
      <img src="https://i.pravatar.cc/100?img=25" class="w-6 h-6 rounded-full border border-[#171a29]" />
      <img src="https://i.pravatar.cc/100?img=36" class="w-6 h-6 rounded-full border border-[#171a29]" />
    </div>
  </div>
</div>